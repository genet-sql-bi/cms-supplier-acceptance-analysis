	column Risk_Order =
			
			VAR p = Fact_Providers[Predicted_Probability]
			RETURN
			SWITCH(
			    TRUE(),
			    p >= 0.6, 1,
			    p >= 0.3, 2,
			    3
			)
		isHidden
		formatString: 0
		lineageTag: 1c89cb2a-7797-4916-9f61-16fba8cf6bff
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Actual_Label = IF( Fact_Providers[Actual_Acceptance_Bool], "ActuallyAccepted", "ActuallyDeclined" )
		lineageTag: 82acc4c8-a882-4f88-aea7-622ae10555f6
		summarizeBy: none

